{
  "name": "dg-cell-mvi-admin-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal runnable admin starter on the @dg-cell-mvi admin chassis (login + layout + one example CRUD page). Copy this folder to scaffold a new backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,json}\""
  },
  "dependencies": {
    "dg-cell-mvi-admin-contract": "^0.1.0",
    "dg-cell-mvi-admin-logic": "^0.1.0",
    "dg-cell-mvi-admin-support": "^0.1.0",
    "dg-cell-mvi-core": "^0.1.0",
    "dg-cell-mvi-crud": "^0.1.0",
    "dg-cell-mvi-element-plus": "^0.1.0",
    "dg-cell-mvi-vue": "^0.1.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^4.1.1",
    "alien-signals": "^3.1.2",
    "depa-data-graph-core": "^0.1.1",
    "depa-data-graph-vue": "^0.1.1",
    "element-plus": "^2.11.4",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "vue": "^3.5.22",
    "vue-i18n": "^9",
    "vue-router": "^4.3.0",
    "xstream": "^11.14.0"
  },
  "devDependencies": {
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "typescript": "^5.4.5",
    "vite": "^7.1.7",
    "vite-plugin-compression2": "^1.3.3"
  }
}
