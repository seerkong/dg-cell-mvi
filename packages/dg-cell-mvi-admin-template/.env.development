# Development mode (loaded by `vite` / `vite dev`).
# `VITE_APP_API` is a same-origin prefix that vite's server.proxy forwards to your backend (no CORS in dev).

# API prefix proxied to VITE_APP_PROXY_TARGET by the dev server.
VITE_APP_API=/api

# Dev backend the `/api` prefix is proxied to (consumed by vite.config.ts, NOT by app code).
VITE_APP_PROXY_TARGET=http://127.0.0.1:7001

# Transport in dev. Unset / anything-but-'false' → use the in-process MOCK HttpPort
# (src/chassis/mockHttpPort.ts) so login + the example CRUD page work WITHOUT a backend.
# Set to 'false' to use the real axios transport (then VITE_APP_API is proxied to the target above).
VITE_APP_MOCK=true

VITE_APP_TITLE=Admin Template (dev)
VITE_APP_STORAGE=admin-template
