{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "ignoreDeprecations": "5.0",
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "dg-cell-mvi-core": ["../dg-cell-mvi-core/src/index.ts"],
      "dg-cell-mvi-halfcode-contract": ["../dg-cell-mvi-halfcode-contract/src/index.ts"],
      "dg-cell-mvi-halfcode-element-plus": ["./src/index.ts"],
      "dg-cell-mvi-halfcode-logic": ["../dg-cell-mvi-halfcode-logic/src/index.ts"],
      "dg-cell-mvi-halfcode-support": ["../dg-cell-mvi-halfcode-support/src/index.ts"],
      "dg-cell-mvi-halfcode-vue": ["../dg-cell-mvi-halfcode-vue/src/index.ts"],
      "depa-data-graph-core": ["../../../depa-data-graph/packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
