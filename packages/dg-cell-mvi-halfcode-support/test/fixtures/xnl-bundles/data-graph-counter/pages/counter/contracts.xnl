<Contracts #counter-page-contracts (
  <PageContract #dg.demo.counter.CounterPage {
    urlInputs = { query = {} }
  }>
) [
  <ElementContract #increment-button (
    <Requires {
      commands = [ "command://#counter.increment" ]
      config = [ "config://#counter-actions" ]
    }>
    <Sends [ <Command ref="command://#counter.increment"> ]>
  )>
]>
