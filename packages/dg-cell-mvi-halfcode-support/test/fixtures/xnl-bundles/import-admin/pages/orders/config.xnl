<Config #orders-page-config [
  <ConfigEntry #orders-page {
    layout = "top"
  }>
  <ConfigEntry #orders-table {
    columns = [
      { field = "name" label = "名称" }
      { field = "score" label = "评分" }
      { field = "status" label = "状态" }
    ]
  }>
  <ConfigEntry #resources {
    ordersPage = { source = "mock" collection = "orders" }
  }>
]>
