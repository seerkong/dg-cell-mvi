<Contracts #crud-table-contracts (
  <ComponentContract #dg.materials.CrudTable (
    <Props { pageSize = "number?" entity = "string?" }>
    <Slots [ <SlotDef #toolbar> ]>
    <Accepts [ <Command ref="command://#table.refresh"> ]>
    <Sends [ <Event ref="event://#table.rowSelected"> ]>
    <Exposes { selectedRowIds = "string[]" }>
  )>
)>
