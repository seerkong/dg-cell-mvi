<AIDataWorkflow #dg.demo.flow.SupportEvidence apiVersion="depa.flows/v1" version="0.1.0" (
  <FlowContract #dg.demo.flow.SupportEvidence {
    inputPorts = ["ticket"]
    outputPorts = ["summary"]
  }>
  <FlowAuthoring #dg.demo.flow.SupportEvidence { viewport = { x = 0 y = 0 zoom = 1 } } [
    <NodeLayout #entry { x = 80 y = 120 }>
    <NodeLayout #retrieve { x = 360 y = 120 }>
    <NodeLayout #summarize { x = 640 y = 120 }>
    <NodeLayout #return { x = 920 y = 120 }>
  ]>
) [
  <EntryNode #entry>
  <TransformNode #retrieve {
    inputs = { ticket = "flow-port://#entry/ticket" }
    outputs = ["evidence"]
    src = "vfs://./flow-code/ai.data.ts#retrieveEvidence"
    config = { reuse_policy = "semantic-hash" }
  }>
  <TransformNode #summarize {
    inputs = { evidence = "flow-port://#retrieve/evidence" }
    outputs = ["summary"]
    src = "vfs://./flow-code/ai.data.ts#summarizeEvidence"
    config = { node_type = "manual" }
  }>
  <ReturnNode #return {
    inputs = { summary = "flow-port://#summarize/summary" }
  }>
]>
