# Shared defaults for all modes (Vite loads `.env` first, then mode-specific files override).
# NOTE: repo .gitignore ignores `.env`; the committed dev/prod values live in
# `.env.development` / `.env.production`. This file is a safe local-override base.

# API base / prefix consumed by dg-cell-mvi-admin-support env util (getApiBase()).
VITE_APP_API=/api

# App title (document.title / login header).
VITE_APP_TITLE=dg-cell-mvi Admin

# StoragePort key namespace short-name.
VITE_APP_STORAGE=admin
