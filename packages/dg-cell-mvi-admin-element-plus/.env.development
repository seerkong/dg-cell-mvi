# Development mode (loaded by `vite` / `vite dev`). Overrides `.env`.
# `VITE_APP_API` here is a same-origin prefix that vite's server.proxy forwards to the backend
# (see vite.config.ts server.proxy), so the browser never hits CORS in dev.

# API prefix proxied to VITE_APP_PROXY_TARGET by the dev server.
VITE_APP_API=/api

# Dev backend the `/api` prefix is proxied to (consumed by vite.config.ts, NOT by app code).
VITE_APP_PROXY_TARGET=http://127.0.0.1:7001

# Auth transport in dev. Unset/anything-but-'false' → use the in-process MOCK HttpPort
# (chassis/mockHttpPort.ts) so login works WITHOUT a backend. Set to 'false' to use the real axios
# transport (then VITE_APP_API is proxied to VITE_APP_PROXY_TARGET above). P3 does the proper switch.
VITE_APP_MOCK=true

VITE_APP_TITLE=dg-cell-mvi Admin (dev)
VITE_APP_STORAGE=admin
