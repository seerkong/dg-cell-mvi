# Staging build (loaded by `vite build --mode staging`). Overrides `.env`.
# Same pipeline as production (gzip + manualChunks), just a different env target — point the API at
# the staging gateway and label the build so it's obvious which environment a deploy came from.

VITE_APP_API=/api
VITE_APP_TITLE=dg-cell-mvi Admin (staging)
VITE_APP_STORAGE=admin
