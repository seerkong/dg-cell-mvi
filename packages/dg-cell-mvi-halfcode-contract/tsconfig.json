{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "dg-cell-mvi-halfcode-contract/test-fixtures/xnl-rich-document": ["./test-fixtures/xnl-rich-document.ts"],
      "dg-cell-mvi-halfcode-contract": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
